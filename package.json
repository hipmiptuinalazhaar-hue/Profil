{
  "name": "hipmi-pt-uin-alazhaar-digital-headquarters",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "assets:materialize": "node scripts/materialize-assets.mjs",
    "dev": "npm run assets:materialize && next dev --turbopack",
    "build": "npm run assets:materialize && next build",
    "start": "next start",
    "dev:vinext": "npm run assets:materialize && vinext dev",
    "build:vinext": "npm run assets:materialize && vinext build",
    "start:vinext": "vinext start",
    "validate": "npm run typecheck && npm run lint",
    "build:cloudflare": "npm run assets:materialize && npm run validate && vinext build",
    "preview:cloudflare": "npm run start:vinext",
    "deploy:cloudflare": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.7",
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "sharp": "0.35.4",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "wrangler": "4.131.0"
  }
}
